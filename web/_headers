# Cabeçalhos de segurança (equivalente ao que o netlify.toml fazia).
# A Cloudflare Pages lê este arquivo da pasta publicada.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Página de links do PEG: pública, mas fora dos buscadores.
/peg
  X-Robots-Tag: noindex, nofollow
/peg.html
  X-Robots-Tag: noindex, nofollow
